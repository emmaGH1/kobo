# Public model settings and empty secret placeholders. Never commit real credentials.
# Responses-compatible API base URL, including its version path (no /responses suffix).
# Direct Meta: https://api.meta.ai/v1 + muse-spark-1.3. Vercel AI Gateway: its /v1 URL + meta/muse-spark-open.
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
MODEL_API_KEY=
# Direct Meta Muse Voice key (required when text uses a gateway).
# MODEL_API_KEY fallback is allowed only for the direct https://api.meta.ai text base.
# ASR endpoint/model are fixed in src/server/voice/index.ts, not MODEL_BASE_URL/MODEL_ID.
VOICE_API_KEY=
# Optional per-owner product hints for voice, e.g. {"owner":["cabin biscuit","groundnut oil"]}
VOICE_PRODUCT_NAMES_JSON=
# Owner login passcode, at least 12 characters.
OWNER_PASSCODE=

# Storage (defaults: SQLite in the app folder, audio in private/audio)
KOBO_DB_PATH=
KOBO_AUDIO_DIR=

# Judge demo ("Your turn")
# Daily cap on real model calls across all demo sessions (default 100).
KOBO_DEMO_DAILY_CAP=100
# Set to 1 only behind the Caddy config in deploy/, which sets X-Real-IP.
KOBO_TRUST_PROXY_IP=

# Reminders: bearer token for POST /api/reminders/tick from an external scheduler.
KOBO_REMINDER_CRON_TOKEN=

# WhatsApp Cloud API (see docs/WHATSAPP-SETUP.md)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Graph API version from the dashboard, e.g. v23.0
WHATSAPP_GRAPH_VERSION=
# Sender digits (no +) to an existing non-demo owner, e.g. {"2348000000000":"owner"} (fictional)
WHATSAPP_OWNER_MAP_JSON=
